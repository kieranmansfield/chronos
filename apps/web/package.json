{
  "name": "@chronos/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:analyze": "nuxt build --analyze",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "analyze": "nuxt analyze",
    "content:build": "nuxt content build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "cleanup": "nuxt cleanup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:js": "eslint --fix",
    "lint:style": "stylelint --fix \"**/*.{vue,scss,css}\" --ignore-path .gitignore",
    "lint": "pnpm run lint:js && pnpm run lint:style",
    "lint:fix": "eslint . --fix",
    "lint:types": "vue-tsc --noEmit --strict",
    "lint:all": "pnpm run lint && pnpm run lint:types && pnpm run format:check",
    "format": "prettier --config ../../prettier.config.cjs --ignore-path ../../.prettierignore --write .",
    "format:fix": "prettier --config ../../prettier.config.cjs --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --config ../../prettier.config.cjs --ignore-path ../../.prettierignore --check .",
    "fix": "pnpm run format:fix && pnpm run lint:fix",
    "typecheck": "nuxt typecheck",
    "netlify": "NODE_ENV=production pnpm dlx nuxi build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.2",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/hints": "1.1.3",
    "@nuxt/scripts": "1.2.1",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/device": "^4.0.0",
    "@nuxtjs/seo": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^14.3.0",
    "better-sqlite3": "^12.11.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tailwindcss": "^4.0.3",
    "eslint-plugin-vue": "^10.9.2",
    "feed": "^5.2.1",
    "gsap": "^3.15.0",
    "hookable": "^6.1.1",
    "kmcom-nuxt-layers": "^2.3.2",
    "locomotive-scroll": "^5.0.1",
    "nuxt": "^4.4.8",
    "prettier": "^3.8.4",
    "resend": "^6.14.0",
    "stylelint": "^17.13.0",
    "tailwindcss": "^4.3.1",
    "v-gsap-nuxt": ">=1.5.12",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "@iconify-json/vscode-icons": "^1.2.58",
    "@nuxt/content": "^3.14.0",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4",
    "@nuxtjs/html-validator": "^2.1.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-pnpm": "^1.6.1",
    "happy-dom": "^20",
    "playwright": "^1.61.0",
    "prettier-plugin-glsl": "^0.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4",
    "vue-tsc": "^3.3.5"
  }
}
